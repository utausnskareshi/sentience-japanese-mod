<Window x:Class="SentienceJP.Patcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="680" Height="580" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        FontFamily="Yu Gothic UI, Meiryo UI, Segoe UI"
        FontSize="14"
        UseLayoutRounding="True">
    <!--
      メイン画面。ゲームの場所・ビルドID・状態を表示し、状態に応じたボタン（日本語化する／元に戻す 等）を出す。
      ゲームのロゴや画像は使わない。
      読み上げソフト向けに、表示文字列を持たないコントロール（ゲームの場所・進行表示・ログ）には AutomationProperties.Name を付ける。
      補助的な文字の色は固定色ではなくシステム色（GrayText）を使い、コントラストテーマにも従わせる（AA-10）。
    -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 見出し -->
        <TextBlock Grid.Row="0"
                   Text="Sentience: The Android's Tale 日本語化パッチ"
                   FontSize="20" FontWeight="SemiBold"
                   Margin="0,0,0,14" TextWrapping="Wrap" />

        <!-- ゲームの情報と状態 -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="ゲームの場所" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Margin="0,0,16,6" />
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding GameDirectory, Mode=OneWay}"
                     AutomationProperties.Name="ゲームの場所"
                     IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0"
                     TextWrapping="Wrap" Margin="0,0,0,6" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="ビルドID" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Margin="0,0,16,6" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding BuildIdText}" TextWrapping="Wrap" Margin="0,0,0,6" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="状態" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Margin="0,0,16,6" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding StatusText}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6" />

            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding StatusDetail}" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" FontSize="12" TextWrapping="Wrap" />
        </Grid>

        <!-- 操作ボタン -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,16">
            <Button Style="{StaticResource PrimaryButton}"
                    Content="{Binding MainButtonText}"
                    Command="{Binding MainCommand}" />
            <Button Style="{StaticResource SecondaryButton}"
                    Content="元に戻す"
                    Command="{Binding RestoreCommand}"
                    Margin="12,0,0,0"
                    Visibility="{Binding ShowSecondaryRestore, Converter={StaticResource BoolToVisibility}}" />
            <ProgressBar Width="120" Height="8" Margin="16,0,0,0" VerticalAlignment="Center"
                         AutomationProperties.Name="処理中"
                         IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <!-- ログ -->
        <TextBlock Grid.Row="3" Text="ログ" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Margin="0,0,0,4" />
        <TextBox Grid.Row="4" x:Name="LogBox"
                 AutomationProperties.Name="ログ"
                 Text="{Binding LogText, Mode=OneWay}"
                 IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto"
                 TextWrapping="Wrap"
                 FontFamily="Consolas, Yu Gothic UI"
                 FontSize="12"
                 TextChanged="OnLogTextChanged" />

        <!-- 注記 -->
        <TextBlock Grid.Row="5" Text="{Binding FooterText}" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap" />
    </Grid>
</Window>
